# Gemma 4 backend: "gemini" (Gemma 4 on the Gemini API) or "ollama" (Gemma 4 running locally)
LLM_BACKEND=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b-it-qat
EMBED_MODEL=embeddinggemma

# Neon Postgres connection string (with pgvector)
DATABASE_URL=

# ElevenLabs Conversational AI agent (voice). The agent's "Custom LLM" points at <public url>/v1
ELEVENLABS_AGENT_ID=
# Shared secret ElevenLabs sends as a Bearer token to /v1/chat/completions (optional)
CUSTOM_LLM_SECRET=
